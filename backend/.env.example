# AutoBounty Backend Environment Variables
NODE_ENV=development
PORT=8000

# Database
DATABASE_URL=sqlite:///./autobounty.db
# PostgreSQL: postgresql://user:password@localhost:5432/autobounty_db

# API Keys
SHODAN_API_KEY=your_shodan_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here
GITHUB_TOKEN=your_github_token_here

# Bug Bounty Platforms
HACKERONE_API_KEY=your_hackerone_key_here
BUGCROWD_API_KEY=your_bugcrowd_key_here

# Security
SECRET_KEY=your_secret_key_here

# Scheduler
SCHEDULER_INTERVAL_HOURS=24

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/autobounty.log
